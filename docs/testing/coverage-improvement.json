  "remainingGapReasons": {
    "copy_null_after_validation": "copyOf validates every row before cloning; a null row cannot reach the subsequent null-copy arm without racing input mutation.",
    "oversized_flatten": "The guard needs a valid matrix containing more than Integer.MAX_VALUE cells. Constructors reject aliased rows; allocating billions of real cells is unsuitable for an ordinary unit suite.",
    "oversized_stack_rows": "The instance stacking guard requires two actual backing arrays whose combined row count exceeds Integer.MAX_VALUE. Collection stacking overflow is covered using bounded-memory repeated references.",
    "oversized_reshape_rows": "A reshaped row count beyond Integer.MAX_VALUE requires a valid source matrix containing more than Integer.MAX_VALUE cells.",
    "row_major_chunk_invariant": "The remaining length ends at the selected final row boundary, so every copied chunk reaches the current row end. The false branch of the row-end check cannot occur.",
    "class_lookup_never_null": "ClassUtil.forName returns a non-null Class or throws; its null result branches cannot occur. Exception and LinkageError detection fallback are tested.",
    "sealed_hierarchy_exhaustive": "AbstractMatrix is sealed and all permitted concrete types are handled before this unsupported-type branch.",
    "typed_stack_same_class": "The public stack generic bound requires one concrete matrix type. Different runtime matrix classes require heap pollution or a raw/unchecked call that violates that contract.",
    "common_type_redundant_assignability": "A candidate found in both ancestry maps is assignable from both input types. The redundant negative checks and the continue bytecode reached only through the last check cannot execute.",
    "common_type_antisymmetry": "Distinct Class objects cannot be assignable from one another in both directions. The final negative assignability guard is redundant.",
    "single_class_inheritance": "Only a class has a superclass; single class inheritance and a fresh traversal map prevent a superclass from having been visited before its unique child.",
    "string_builder_no_io_exception": "The escaping helper uses StringBuilder as its Appendable, whose append methods do not throw IOException.",
    "always_throwing_call_probe": "The narrowing overflow test executes this Math.toIntExact call and asserts ArithmeticException. It always exits through a called method exception before a following JaCoCo probe, so JaCoCo reports the line missed."
  },
